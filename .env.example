LLM_PROVIDER=mock
LLM_ENABLE_REAL_CALL=false
OPENAI_API_KEY=your_api_key_here
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=
LLM_API_KEY_ENV=OPENAI_API_KEY
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.2
LLM_LOG_PATH=data/logs/llm_call_log.csv

# Local stack suggestions:
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# VLLM_BASE_URL=http://127.0.0.1:8000/v1
# LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
# LLM_PROVIDER=openai
# OPENAI_MODEL=Qwen/Qwen3-14B-Instruct
# OPENAI_BASE_URL=http://127.0.0.1:11434/v1
# OPENAI_API_KEY=ollama

EMBEDDING_PROVIDER=none
EMBEDDING_MODEL=bge-m3
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=

VECTORSTORE_TYPE=dummy
VECTORSTORE_PATH=data/indexes
VECTORSTORE_BACKEND=faiss
MILVUS_URI=http://127.0.0.1:19530
MILVUS_DB_NAME=default
MILVUS_COLLECTION=newspilot_chunks
CHROMA_PERSIST_DIR=data/indexes/chroma
FAISS_INDEX_PATH=data/indexes/faiss/index.bin

LOG_LEVEL=INFO

REVIEW_TIMEOUT_SECONDS=120
MAX_CONCURRENT_REVIEWS=3
CORS_ORIGINS=http://localhost:5173,https://litchi3914.github.io

# Supabase backend-only settings. Do not expose these in frontend/.env.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=your-supabase-secret-key
SUPABASE_SERVICE_ROLE_KEY=your-legacy-service-role-key-if-used
ENABLE_REVIEW_RECORD_STORAGE=false
ENABLE_SUPABASE_RAG=false
EMBEDDING_DIM=
